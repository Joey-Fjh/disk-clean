{
  "rules": [
    {
      "id": "cursor-cache",
      "name": "Cursor 缓存",
      "category": "safe",
      "contentType": "agent",
      "paths": ["%APPDATA%\\Cursor"],
      "globDirs": ["Cache", "Code Cache", "GPUCache", "CachedData", "logs", "Crashpad"],
      "maxDepth": 2,
      "defaultChecked": false,
      "reason": "Cursor 编辑器缓存与日志",
      "impact": "不影响用户配置、扩展、会话与 SQLite 状态",
      "rebuildable": true,
      "cleanupStrategy": "trash",
      "requiresAppClosed": true,
      "reviewStatus": "conservative",
      "exclusions": ["User", "Local Storage", "Session Storage", "Cookies", "Network"],
      "notes": "不触及 auth、conversation、settings、plugins"
    },
    {
      "id": "claude-desktop-cache",
      "name": "Claude 桌面版缓存",
      "category": "safe",
      "contentType": "agent",
      "paths": ["%APPDATA%\\Claude"],
      "globDirs": ["Cache", "Code Cache", "GPUCache", "logs", "Crashpad"],
      "maxDepth": 2,
      "defaultChecked": false,
      "reason": "Claude 客户端缓存与日志",
      "impact": "不影响账号与对话记录",
      "rebuildable": true,
      "cleanupStrategy": "trash",
      "requiresAppClosed": true,
      "reviewStatus": "conservative",
      "exclusions": ["Local Storage", "Session Storage", "Cookies"],
      "notes": "不触及认证与会话数据"
    },
    {
      "id": "codex-cache",
      "name": "Codex 缓存",
      "category": "safe",
      "contentType": "agent",
      "paths": ["%LOCALAPPDATA%\\codex", "%APPDATA%\\Codex"],
      "globDirs": ["Cache", "cache", "logs", "GPUCache"],
      "maxDepth": 2,
      "defaultChecked": false,
      "reason": "Codex 客户端缓存与日志",
      "impact": "不影响账号数据",
      "rebuildable": true,
      "cleanupStrategy": "trash",
      "requiresAppClosed": true,
      "reviewStatus": "conservative",
      "notes": "不触及认证、会话与 SQLite 状态"
    }
  ]
}
