{
  "name": "disk-clean",
  "version": "0.1.0",
  "description": "规则驱动的 Windows 磁盘清理工具",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.diskclean.app",
    "productName": "Disk Clean",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Disk Clean"
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  }
}
